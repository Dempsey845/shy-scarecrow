[sub_resource type="BoxShape3D" id="WaterVolumeShape"]
size = Vector3(8, 1.68, 5)

[sub_resource type="Shader" id="BorderRockShader"]
code = "shader_type spatial;
render_mode cull_disabled;
uniform vec4 stone_color : source_color = vec4(0.39, 0.37, 0.31, 1.0);
uniform vec4 moss_color : source_color = vec4(0.30, 0.34, 0.18, 1.0);
varying vec3 world_position;
void vertex() { world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }
void fragment() {
 vec3 flat_normal = normalize(cross(dFdx(VERTEX), dFdy(VERTEX)));
 if (dot(flat_normal, NORMAL) < 0.0) { flat_normal = -flat_normal; }
 NORMAL = flat_normal;
 vec3 world_normal = normalize((INV_VIEW_MATRIX * vec4(flat_normal, 0.0)).xyz);
 float mottling = sin(world_position.x * 2.1 + sin(world_position.z * 1.9)) * sin(world_position.y * 3.4 + world_position.z * 2.3);
 float patches = smoothstep(0.10, 0.65, mottling);
 float moss = smoothstep(0.45, 0.85, world_normal.y) * patches * 0.72;
 ALBEDO = mix(stone_color.rgb * (0.91 + mottling * 0.09), moss_color.rgb, moss);
 ROUGHNESS = 0.97;
}"

